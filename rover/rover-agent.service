# systemd service: starts the rover agent automatically when the Pi boots.
# Install (on the Pi):
#   sudo cp ~/rover/rover-agent.service /etc/systemd/system/
#   sudo nano /etc/systemd/system/rover-agent.service      # set User, paths and --token
#   sudo systemctl daemon-reload && sudo systemctl enable --now rover-agent
#   journalctl -u rover-agent -f                           # watch its log
[Unit]
Description=AI Surveillance Rover agent (camera stream + drive commands)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/rover
ExecStart=/usr/bin/python3 /home/pi/rover/rover_agent.py --token change-me
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
